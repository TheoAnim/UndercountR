model{
 for(i in 1:n_obs){
            yobs[i] ~ dnegbin(prob, c)
            loglik[i] <- logdensity.negbin(yobs[i], prob, c)
          }
        #validation data
        for(j in 1:n_valdata){
          ystar[j] ~ dnegbin(prob_ystar, c)
          yval[j] ~ dbin(p, ystar[j])
          loglik[n_obs + j] <- logdensity.negbin(ystar[j], prob_ystar, c) + logdensity.bin(yval[j], p, ystar[j])
        }

    #hyperpriors
    prob <- c/(c + lambda * p)
    c ~ prior_c
    lambda ~  prior_lambda
    p ~ prior_p
    prob_ystar <- c/(c + lambda)
}
