model{
  #observed data
 for(i in 1:n_obs){
            yobs[i] ~ dpois(mu[i])
            mu[i] <- lambda*is_zero[i] + 0.0001
            is_zero[i] ~ dbern(1 - pi)
            loglik[i] <- logdensity.pois(yobs[i], mu[i])
          }
 #hyperpriors
        pi ~ prior_pi
        lambda ~  prior_lambda
}


